# Database
DATABASE_URL=postgresql+psycopg://ara:ara_prod_password@db:5432/ara

# Redis
REDIS_URL=redis://redis:6379/0

# JWT - GENERATE A REAL SECRET: openssl rand -hex 32
SECRET_KEY=replace-with-a-real-secret-key

# CORS - comma-separated origins for production
CORS_ORIGINS=https://your-domain.com

# S3 / MinIO - use real S3 in production
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ara_minio
S3_SECRET_KEY=ara_minio_secret
S3_BUCKET=resumes
S3_REGION=us-east-1
S3_USE_SSL=false

# LLM
LLM_PROVIDER=ollama
LLM_API_BASE=http://ollama:11434
LLM_MODEL=qwen2.5-coder:7b

# App
ENVIRONMENT=production
LOG_LEVEL=WARNING

# Frontend
NEXT_PUBLIC_API_URL=https://api.your-domain.com