# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=ara
POSTGRES_PASSWORD=ara_dev_password
POSTGRES_DB=ara
DATABASE_URL=postgresql+psycopg://ara:ara_dev_password@localhost:5432/ara

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible) ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ara_minio
S3_SECRET_KEY=ara_minio_secret
S3_BUCKET=resumes
S3_REGION=us-east-1
S3_USE_SSL=false

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM (stub — configure when implementing analysis) ────────
LLM_PROVIDER=ollama
LLM_API_BASE=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
