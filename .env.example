# Database
DATABASE_URL=postgresql+psycopg://ara:ara_dev_password@localhost:5432/ara

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# CORS
CORS_ORIGINS=http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ara_minio
S3_SECRET_KEY=ara_minio_secret
S3_BUCKET=resumes
S3_REGION=us-east-1
S3_USE_SSL=false

# LLM
LLM_PROVIDER=ollama
LLM_API_BASE=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# App
ENVIRONMENT=development
LOG_LEVEL=INFO