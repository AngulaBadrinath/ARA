{
  "name": "ara",
  "version": "1.0.0",
  "private": true,
  "description": "AI resume Analyzer ",
  "homepage": "https://github.com/AngulaBadrinath/ARA#readme",
  "bugs": {
    "url": "https://github.com/AngulaBadrinath/ARA/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngulaBadrinath/ARA.git"
  },
  "license": "ISC",
  "author": "Angula Badrinath",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ara/web --filter @ara/api dev",
    "dev:web": "pnpm --filter @ara/web dev",
    "dev:api": "pnpm --filter @ara/api dev",
    "build": "pnpm --filter @ara/shared-types build && pnpm --filter @ara/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-scope": "^8.4.0",
    "eslint-visitor-keys": "^4.2.1"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
